<?xml version="1.0"?>
<ruleset name="Komerza for WooCommerce">
	<description>WordPress coding standards. Class files are named after their class, so the file name rule is left out.</description>

	<file>.</file>
	<exclude-pattern>/dev/*</exclude-pattern>
	<arg name="extensions" value="php"/>

	<config name="minimum_wp_version" value="6.2"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="komerza-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="komerza"/>
				<element value="Komerza\WooCommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
